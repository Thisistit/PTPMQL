@model DemoMVC.Models.Entities.Student

<h2>Xóa sinh viên</h2>

<h4>Bạn có chắc muốn xóa không?</h4>

<div>
    <p><strong>Mã SV:</strong> @Model.StudentCode</p>
    <p><strong>Tên:</strong> @Model.FullName</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="StudentCode" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>